# Production: ultralove.ca
DEPLOY_HOST=ultralove-prod-app
WP_ROOT=/var/www/html
SITE_URL=https://ultralove.ca
# The replacement production droplet (Ubuntu 26.04, PHP 8.5). No deploys go to today's droplet (PHP 8.3)
# before the replacement is live.
PHP_FPM_SERVICE=php8.5-fpm
WEB_USER=www-data
STATE_DIR=/var/lib/ultralove-deploy
# Prod only accepts commits that are on origin/main and already live on dev.
REQUIRE_BRANCH=origin/main
REQUIRE_DEV_GATE=1
