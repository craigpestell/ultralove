# Development: dev.ultralove.ca
# NOTE: the dev droplet was destroyed on 2026-09-24 after a compromise.
# Update DEPLOY_HOST (and ~/.ssh/config) once it is rebuilt.
DEPLOY_HOST=ultralove-dev-app
WP_ROOT=/var/www/html
SITE_URL=https://dev.ultralove.ca
PHP_FPM_SERVICE=php8.3-fpm
WEB_USER=www-data
STATE_DIR=/var/lib/ultralove-deploy
# Dev accepts any commit that has been pushed to GitHub.
REQUIRE_BRANCH=
REQUIRE_DEV_GATE=0
