/*
!.gitignore
!README.md
!/documentation/
!/wp-content/
!/deploy/
!/ops/
!/.github/
!/.claude/

/wp-content/*

!/wp-content/object-cache.php
!/wp-content/cloudinary-audit.php
!/wp-content/cloudinary-audit-v2.php
!/wp-content/cloudinary-sync-recover-safe.php
!/wp-content/cloudinary-sync-throttled.php
!/wp-content/run-cloudinary-workers.sh

# All MU plugins are ours except the ManageWP loader, which ManageWP regenerates.
!/wp-content/mu-plugins/
/wp-content/mu-plugins/0-worker.php

!/wp-content/plugins/
/wp-content/plugins/*
!/wp-content/plugins/hide-price-until-login/
!/wp-content/plugins/ultralove-*/

!/wp-content/themes/
/wp-content/themes/*
!/wp-content/themes/martfury/
!/wp-content/themes/martfury-child/

# Business/financial records (invoices, statements) never belong in this repo.
/documentation/invoice*
/documentation/**/invoice*
/documentation/**/statement-*
*.xlsx

# Never commit DB dumps, backups, archives, secrets or local state.
*.zip
*.sql
*.sql.gz
*.bak
*.bak-*
*.orig
*.swp
.DS_Store
desktop.ini
.env
/ops/**/.sync-staging/
/ops/**/.dev-validation-passed
/.claude/settings.local.json
