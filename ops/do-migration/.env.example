# Copy to .env and update values before running scripts.

# DigitalOcean API + region
DO_REGION=sfo2
DO_VPC_UUID=13c4a945-3cb1-4b91-a483-ce0364f55dba
DO_PROJECT_ID=333eb857-ce4c-4224-9fea-c57a2ada860c

# SSH key id or fingerprint from: doctl compute ssh-key list
DO_SSH_KEY_ID=b9:01:a6:a5:c5:65:9d:3b:c2:5b:0b:47:b0:61:a0:9f

# App droplets (same size for prod/dev)
APP_DROPLET_SIZE=s-2vcpu-4gb
APP_IMAGE=ubuntu-24-04-x64

# Dev DB droplet
DEV_DB_DROPLET_SIZE=s-1vcpu-2gb
DB_IMAGE=ubuntu-24-04-x64

# Naming
PROD_APP_NAME=ultralove-prod-app
DEV_APP_NAME=ultralove-dev-app
DEV_DB_NAME=ultralove-dev-db

# Domains
PROD_DOMAIN=ultralove.ca
DEV_DOMAIN=dev.ultralove.ca
DEV_NEW_APP_IP=138.68.49.58
PROD_NEW_APP_IP=

# Sync source/destination settings
DEST_WP_ROOT=/var/www/html
SRC_WP_PATH=/var/www/html
# For --from-source-server mode, SRC_WP_PATH should be the local path on that server.
SRC_APP_IP=
SRC_APP_SSH_USER=root
SRC_APP_SSH_PORT=22
SYNC_STAGING_DIR=./.sync-staging/dev

# Backward compatibility aliases (can be removed after migration to SRC_/DEST_)
WP_ROOT=/var/www/html
LOCAL_WP_SOURCE=/var/www/html
PROD_OLD_APP_IP=
PROD_OLD_APP_SSH_USER=root
PROD_OLD_APP_SSH_PORT=22
PROD_OLD_WP_SOURCE=/var/www/html

# SSH settings for destination app droplets
APP_SSH_PORT=22
DEV_NEW_APP_SSH_USER=root
PROD_NEW_APP_SSH_USER=root

# Database settings for dev DB initialization
DEV_DB_NAME_WORDPRESS=wordpress_dev
DEV_DB_USER=ultra_dev
DEV_DB_PASS=ultraL0v3!
DEV_DB_HOST=10.120.0.5
DEV_DB_PORT=3306

# Production DB source for cloning into dev
SRC_DB_HOST=142.93.94.167
SRC_DB_NAME=wordpress
SRC_DB_USER=ultra
SRC_DB_PASS=UltraL0v3!

# Sanitization targets
SANITIZE_EMAIL_DOMAIN=example.test
