# Dev environment definition (non-secret). Used by ops/dev/*.sh.
DROPLET_NAME=ultralove-dev
DROPLET_SIZE=s-4vcpu-8gb            # 8 GB, combined web + MySQL
DROPLET_IMAGE=ubuntu-24-04-x64
DO_REGION=sfo2
# Dedicated VPC so dev can't reach prod/mail over the private network.
VPC_NAME=ultralove-dev-vpc
VPC_RANGE=10.140.0.0/20
FIREWALL_NAME=ultralove-dev-fw
# DigitalOcean SSH key ids allowed as root (comma separated). 52345957 = "craig m2".
DO_SSH_KEY_IDS=52345957
TAGS=ultralove,development

DEV_DOMAIN=dev.ultralove.ca
PROD_DOMAIN=ultralove.ca
PROD_HOST=ultralove-prod-app        # ssh alias; source for code + DB refreshes
PROD_PUBLIC_IP=178.128.187.1        # only address allowed to use the prod->dev push key
# Refreshes are pushed prod -> dev directly (same datacenter; nothing via this machine).
# Prod holds a key into dev; dev never gets access to prod.
PUSH_KEY=/root/.ssh/ultralove-dev-push
PUSH_KNOWN_HOSTS=/root/.ssh/ultralove-dev-known_hosts
DEV_HOST_ALIAS=ultralove-dev-app    # ssh alias written to ~/.ssh/config
WP_ROOT=/var/www/html
PHP_VERSION=8.3
DB_NAME=wordpress_dev
DB_USER=wordpress_dev

# Accounts kept intact (not anonymized) on dev: login, email, names, profile and
# password stay as on prod so these people can log in to dev normally.
DEV_KEEP_EMAILS="craigpestell@gmail.com dwatson@telus.net david@ultralove.ca"

# People allowed through Cloudflare Access to dev.ultralove.ca (email one-time PIN login).
DEV_ACCESS_EMAILS="craigpestell@gmail.com dwatson@telus.net david@ultralove.ca"
CF_TUNNEL_NAME=ultralove-dev

# Plugins deactivated on dev after every DB refresh: they hold live credentials
# or act on live external services (ManageWP remote control, Mailgun, Mailchimp,
# Updraft remote storage, Cloudflare cache purges, Cloudinary asset sync, Jetpack).
DEV_DISABLED_PLUGINS="worker mailgun mailchimp-for-wp updraftplus cloudflare wp-cloudflare-super-page-cache cloudinary-image-management-and-manipulation-in-the-cloud-cdn woocommerce-services"

# Outbound HTTP from WordPress on dev is blocked except for these hosts.
WP_ACCESSIBLE_HOSTS="api.wordpress.org,downloads.wordpress.org,*.wordpress.org,*.wp.com"
